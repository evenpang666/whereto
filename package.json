{
  "name": "dsh-whereto",
  "version": "1.0.0",
  "private": true,
  "main": "./dsh/index.mjs",
  "exports": {
    ".": "./dsh/index.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./public/brand/mark.svg",
  "keywords": ["dsh-plugin", "deepseek-harness", "travel"],
  "dsh": { "bundle": { "patch": "./dsh/cordis.patch.yml" } },
  "type": "module",
  "description": "中国地图探索、景点卡片、旅行解读与足迹记录，复用 DSH 模型、凭据与访问认证。",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node scripts/launch.mjs",
    "dsh:install": "node scripts/install-dsh.mjs",
    "launch": "node scripts/launch.mjs",
    "test": "node --test tests/*.test.mjs",
    "data:sync": "node scripts/sync-data.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "d3-geo": "^3.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "vite": "^6.1.0"
  }
}
