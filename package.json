{
  "name": "dsh-whereto",
  "version": "1.0.0",
  "private": true,
  "main": "./dsh/index.mjs",
  "exports": { ".": "./dsh/index.mjs" },
  "keywords": ["dsh-plugin", "deepseek-harness", "travel"],
  "dsh": { "bundle": { "patch": "./dsh/cordis.patch.yml" } },
  "type": "module",
  "description": "漫游地图与卡片，作为 DSH Web 业务插件，由宿主 Agent 会话生成内容。",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node scripts/launch.mjs",
    "dsh:install": "node scripts/install-dsh.mjs",
    "launch": "node scripts/launch.mjs",
    "test": "node --test tests/*.test.mjs",
    "data:sync": "node scripts/sync-data.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "d3-geo": "^3.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "vite": "^6.1.0"
  }
}
